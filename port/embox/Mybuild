package ext_project.port.embox

/* NetBSD kernel-API shims (locks/threads, mbuf, ifnet, firmware lookup)
 * that any USB-backend port for embox builds on. Kept in their own module
 * so a USB port (port/cherryusb) only depends on it. */
module net80211_embox_osal {
	@Cflags("-D_KERNEL")
	@Cflags("-include$(ROOT_DIR)/ext_project/port/port_config.h")
	@IncludePath("$(ROOT_DIR)/ext_project/compat/netbsd")
	@IncludePath("$(ROOT_DIR)/ext_project")
	@IncludePath("$(ROOT_DIR)/ext_project/port")

	source "osal_embox.c", "bsd_mbuf.c", "bsd_ifnet.c", "firmware_embed.c"

	depends embox.kernel.thread.core
	depends embox.kernel.thread.sync
	depends embox.kernel.timer.sys_timer
	depends embox.kernel.timer.sleep
	depends embox.compat.posix.util.gettimeofday
}
