package ext_project.port.cherryusb

/* The CherryUSB host stack (vendored under cherryusb/) with the embox
 * OSAL and the RK3568 EHCI glue. The embox USB stack is not used:
 * enumeration, hub handling and all transfers run on this stack. */
module cherryusb_host {
	@Cflags("-Wno-unused-parameter")
	/* the EHCI hardware link pointers are 32-bit: the truncation is
	 * intentional, every pool sits below 4G on this platform */
	@Cflags("-Wno-pointer-to-int-cast")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/core")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/common")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/class/hub")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/port/ehci")
	source "cherryusb/core/usbh_core.c",
		"cherryusb/class/hub/usbh_hub.c",
		"cherryusb/port/ehci/usb_hc_ehci.c",
		"osal_usb_embox.c",
		"usb_glue_rk3568.c"

	depends embox.kernel.irq
	depends embox.kernel.lthread.lthread
	depends embox.kernel.thread.core
	depends embox.kernel.thread.sync
	depends embox.kernel.timer.sys_timer

	@NoRuntime depends embox.driver.periph_memory
}

/* The net80211 port over cherryusb: the NetBSD-side shims live in the
 * embox OSAL module (ext_project.port.embox.net80211_embox_osal); this
 * module adds the USB layer only. */
module net80211_port_cherryusb {
	@Cflags("-D_KERNEL")
	@Cflags("-include$(ROOT_DIR)/ext_project/port/port_config.h")
	@IncludePath("$(ROOT_DIR)/ext_project/compat/netbsd")
	@IncludePath("$(ROOT_DIR)/ext_project")
	@IncludePath("$(ROOT_DIR)/ext_project/port")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/core")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/common")
	@IncludePath("$(ROOT_DIR)/ext_project/port/cherryusb/cherryusb/class/hub")
	source "usbdi_compat.c",
		"usbh_urtwn_class.c",
		"net_bridge.c"

	depends cherryusb_host
	depends ext_project.port.embox.net80211_embox_osal
	depends embox.kernel.thread.core
	depends embox.kernel.thread.sync
	depends embox.kernel.timer.sys_timer
	depends embox.net.core
	depends embox.net.wifi.cfg80211
	depends ext_project.driver.urtwn.net80211_urtwn
}

@AutoCmd
@App
@Cmd(name = "wlan", help = "net80211 wireless devices")

module net80211_wlan_cmd_cherryusb {
	@IncludePath("$(ROOT_DIR)/ext_project/compat/netbsd")
	@IncludePath("$(ROOT_DIR)/ext_project")
	@IncludePath("$(ROOT_DIR)/ext_project/port")
	source "wlan_cmd.c"

	depends net80211_port_cherryusb
}
